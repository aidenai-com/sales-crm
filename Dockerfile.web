# syntax=docker/dockerfile:1
#
# Builds the React frontend and serves it from Nginx, which also proxies /api to the
# FastAPI container so the browser talks to a single origin and CORS never applies.

FROM node:22-alpine AS build

WORKDIR /app

# Lockfile first, so dependency installs are cached across source changes.
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig*.json vite.config.ts index.html ./
COPY src ./src

RUN npm run build


FROM nginx:1.29-alpine AS runtime

# Replaces the default site with one that knows about the SPA fallback and the API proxy.
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/conf.d/app.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
