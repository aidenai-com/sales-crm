# Copy to .env. docker-compose reads this file for the Postgres settings, and the
# locally-run API reads backend/.env for its own — see backend/.env.example.

POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
POSTGRES_PORT=5433

# --- pgAdmin (opt-in: docker compose --profile tools up -d) ------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@aidenai.com
PGADMIN_PASSWORD=admin1234
