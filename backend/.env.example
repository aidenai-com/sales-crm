# Copy to backend/.env. Read by the locally-run FastAPI app.

# --- Database ---------------------------------------------------------------
# Points at the LOCAL PostgreSQL 18 service on 5432, not the Docker container.
# Set POSTGRES_PORT=5433 to switch back to the container (see docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# --- API --------------------------------------------------------------------
ENVIRONMENT=development

# Generate a real one before deploying anywhere:  openssl rand -hex 32
# The app refuses to start with this default when ENVIRONMENT=production.
SECRET_KEY=dev-only-change-me

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# The Vite dev server's origin. Needed because the API is on a different port.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost

# Set true to echo every SQL statement while debugging a query.
LOG_SQL=false

# --- Seeding ----------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@aidenai.com
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_PASSWORD=password1234
