# Copy to backend/.env. Read by the locally-run FastAPI app.

# --- Database ---------------------------------------------------------------
# Points at the LOCAL PostgreSQL 18 service on 5432, not the Docker container.
# Set POSTGRES_PORT=5433 to switch back to the container (see docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# --- API --------------------------------------------------------------------
ENVIRONMENT=development

# Generate a real one before deploying anywhere:  openssl rand -hex 32
# The app refuses to start with this default when ENVIRONMENT=production.
SECRET_KEY=dev-only-change-me

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# The Vite dev server's origin. Needed because the API is on a different port.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost

# Set true to echo every SQL statement while debugging a query.
LOG_SQL=false

# --- Seeding ----------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@aidenai.com
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_PASSWORD=password1234

# --- Email ------------------------------------------------------------------
# Points at the Mailpit container from docker-compose.yml, which accepts anything and
# delivers nothing. Read what the app sent at http://localhost:8025
#
# Mailpit speaks plain SMTP on 1025 with no TLS and no real auth, so SMTP_USE_TLS must be
# false here — leaving it true makes every send fail on the STARTTLS negotiation.
#
# For a real provider: set the host, port 587, real credentials, and SMTP_USE_TLS=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=crm@localhost
SMTP_USE_TLS=false

# --- AI assistant -----------------------------------------------------------
# Blank key means the assistant still opens and streams, but replies with one sentence
# explaining it is not connected. Fill this in and restart the API to switch it on.
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_ENABLED=true
ASSISTANT_MAX_OUTPUT_TOKENS=800
ASSISTANT_MAX_TOOL_ROUNDS=4

# USD per million tokens, for the usage dashboard. Zero means "rate unknown" and the
# dashboard shows tokens with costs blank rather than printing a false $0.00.
# Take the current numbers from OpenAI's pricing page.
OPENAI_INPUT_COST_PER_1M=0.0
OPENAI_OUTPUT_COST_PER_1M=0.0

# Must be 'none' for reasoning models: /v1/chat/completions refuses reasoning and function
# tools in the same request, and this assistant runs on tools. Empty for a model with no
# reasoning setting, which rejects the parameter as unknown.
OPENAI_REASONING_EFFORT=none
